GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_S=20
SCENE_MODE=local
SCENE_VLM_ENABLED=false
SCENE_VLM_MODEL=mlx-community/Qwen2.5-VL-3B-Instruct-4bit
CAMERA_INDEX=0
AUDIO_VOICE=Mónica
AUDIO_RATE_WPM=190
SCENE_LOCAL_TIMEOUT_S=15
SCENE_MIN_GAP_S=8
SCENE_MAX_SILENCE_S=45
ALERTS_REMINDER_S=12
# Modo celular (Bili): el celular manda los frames y habla él; sin profundidad ni VLM (pesados)
DEPTH_ENABLED=false
CAMERA_SOURCE=remote
AUDIO_OUTPUT=client
# Rutas a pie: clave de Google Cloud restringida a Routes API y Geocoding API
GOOGLE_MAPS_API_KEY=
ROUTES_DAILY_LIMIT=300
